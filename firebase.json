{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/", "destination": "/index.html" },
      { "source": "/signin.html", "destination": "/signin.html" },
      { "source": "/signup.html", "destination": "/signup.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
